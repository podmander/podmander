with "config/podmander_config.gpr";

project Podmander is

   for Source_Dirs use ("src/**");
   for Object_Dir use "obj/" & Podmander_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin/";
   for Main use ("pod_controller.adb", "pod_agent.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Podmander_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); -- Symbolic traceback
   end Binder;

end Podmander;
