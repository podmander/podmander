#
#  Privileged systemd container for runtime integration testing.
#  Built and used locally; not published to any registry.

FROM registry.fedoraproject.org/fedora:43

RUN dnf install -y \
    systemd \
    podman \
    gcc-gnat \
    zeromq-devel \
    czmq-devel \
    && dnf clean all

CMD ["/usr/sbin/init"]
